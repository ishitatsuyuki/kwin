#version 450
#extension GL_EXT_shader_image_load_formatted : require

// A workgroup maps exactly to one 16x16 output tile. Layer colors are
// premultiplied and layers are stored from bottom to top.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct Layer
{
    vec4 rect;
    vec4 color;
    vec4 sourceRect;
    vec4 localRect;
    vec4 inverseTransformX;
    vec4 inverseTransformY;
    vec4 clipRect;
    vec4 textureTransformX;
    vec4 textureTransformY;
    vec4 effects;
    vec4 roundedRect;
    vec4 cornerRadii;
    vec4 colorTransformX;
    vec4 colorTransformY;
    vec4 colorTransformZ;
    vec4 transferParameters;
    vec4 colorParameters;
    vec4 destinationToLmsX;
    vec4 destinationToLmsY;
    vec4 destinationToLmsZ;
    vec4 lmsToDestinationX;
    vec4 lmsToDestinationY;
    vec4 lmsToDestinationZ;
    vec4 toneMappingParameters;
    vec4 yuvTransformX;
    vec4 yuvTransformY;
    vec4 yuvTransformZ;
    vec4 quadPositionX;
    vec4 quadPositionY;
    vec4 quadTextureX;
    vec4 quadTextureY;
    vec4 colorFilterMatrixX;
    vec4 colorFilterMatrixY;
    vec4 colorFilterMatrixZ;
    vec4 colorFilterParameters;
    uvec4 textureIndices;
    uvec4 metadata;
};

layout(std430, set = 0, binding = 0) readonly buffer LayerBuffer
{
    Layer layers[];
};

layout(std430, set = 0, binding = 1) readonly buffer TileBuffer
{
    uint tileData[];
};

// Output dma-bufs can use either RGBA or BGRA channel order. The Vulkan
// device explicitly enables shaderStorageImageReadWithoutFormat and
// shaderStorageImageWriteWithoutFormat so one pipeline can preserve and write
// all storage-capable output formats across descriptor batches.
layout(set = 0, binding = 2) uniform image2D destination;

layout(std430, set = 0, binding = 4) readonly buffer DirtyTileBuffer
{
    uint dirtyTiles[];
};

layout(std430, set = 0, binding = 5) readonly buffer OutputLutBuffer
{
    vec4 outputLut[];
};

layout(set = 0, binding = 3) uniform sampler2D textures[16];

layout(push_constant) uniform Parameters
{
    uint layerCount;
    uint tilesWide;
    uint flags;
    uint dirtyTileCount;
    vec4 background;
    uint firstLayer;
    uint lastLayer;
    uvec2 padding;
    vec4 outputLutParameters;
} params;

vec4 sampleTexture(uint index, vec2 coordinates)
{
    return texture(textures[index], coordinates);
}

float sdfRoundedBox(vec2 position, vec4 rect, vec4 radius)
{
    vec2 center = (rect.xy + rect.zw) * 0.5;
    vec2 extents = (rect.zw - rect.xy) * 0.5;
    vec2 p = position - center;
    float r = p.x > 0.0
        ? (p.y < 0.0 ? radius.y : radius.w)
        : (p.y < 0.0 ? radius.x : radius.z);
    vec2 q = abs(p) - extents + vec2(r);
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
}

float shapeCoverage(Layer layer, vec2 localPosition)
{
    if ((layer.metadata.z & (1u << 1)) == 0u) {
        return 1.0;
    }
    float inner = sdfRoundedBox(localPosition, layer.roundedRect, layer.cornerRadii);
    float distance = inner;
    if ((layer.metadata.z & (1u << 2)) != 0u) {
        vec4 expansion = vec4(layer.effects.z);
        float outer = sdfRoundedBox(localPosition,
                                    layer.roundedRect + vec4(-expansion.xy, expansion.zw),
                                    layer.cornerRadii + vec4(layer.effects.z));
        distance = max(outer, -inner);
    }
    // Compute shaders don't have fragment derivatives. The transform scale
    // converts the local signed distance to an approximately one-pixel ramp.
    return clamp(0.5 - distance * layer.effects.w, 0.0, 1.0);
}

vec3 pqToLinear(vec3 pq)
{
    const float c1 = 0.8359375;
    const float c2 = 18.8515625;
    const float c3 = 18.6875;
    const float inverseM1 = 1.0 / 0.1593017578125;
    const float inverseM2 = 1.0 / 78.84375;
    vec3 powered = pow(clamp(pq, vec3(0.0), vec3(1.0)), vec3(inverseM2));
    return pow(max(powered - c1, vec3(0.0)) / (c2 - c3 * powered), vec3(inverseM1));
}

vec3 linearToPq(vec3 linear)
{
    const float c1 = 0.8359375;
    const float c2 = 18.8515625;
    const float c3 = 18.6875;
    const float m1 = 0.1593017578125;
    const float m2 = 78.84375;
    vec3 powered = pow(clamp(linear, vec3(0.0), vec3(1.0)), vec3(m1));
    return pow((vec3(c1) + c2 * powered) / (vec3(1.0) + c3 * powered), vec3(m2));
}

float singlePqToLinear(float pq)
{
    const float c1 = 0.8359375;
    const float c2 = 18.8515625;
    const float c3 = 18.6875;
    const float inverseM1 = 1.0 / 0.1593017578125;
    const float inverseM2 = 1.0 / 78.84375;
    float powered = pow(clamp(pq, 0.0, 1.0), inverseM2);
    return pow(max(powered - c1, 0.0) / (c2 - c3 * powered), inverseM1);
}

float singleLinearToPq(float linear)
{
    const float c1 = 0.8359375;
    const float c2 = 18.8515625;
    const float c3 = 18.6875;
    const float m1 = 0.1593017578125;
    const float m2 = 78.84375;
    float powered = pow(clamp(linear, 0.0, 1.0), m1);
    return pow((c1 + c2 * powered) / (1.0 + c3 * powered), m2);
}

const mat3 toICtCp = mat3(
    0.5,  1.613769531250,   4.378173828125,
    0.5, -3.323486328125,  -4.245605468750,
    0.0,  1.709716796875,  -0.132568359375
);
const mat3 fromICtCp = mat3(
    1.0,               1.0,              1.0,
    0.00860903703793, -0.008609037037,   0.56031335710680,
    0.11102962500303, -0.111029625003,  -0.32062717498732
);

vec3 doToneMapping(Layer layer, vec3 color)
{
    float maximumInput = layer.toneMappingParameters.x;
    float maximumOutput = layer.colorParameters.w;
    if (maximumInput < maximumOutput * 1.01) {
        return clamp(color, vec3(0.0), vec3(maximumOutput));
    }

    vec4 destination = vec4(color, 1.0);
    vec3 lms = vec3(dot(layer.destinationToLmsX, destination),
                    dot(layer.destinationToLmsY, destination),
                    dot(layer.destinationToLmsZ, destination));
    vec3 ictcp = toICtCp * linearToPq(lms / 10000.0);
    float luminance = singlePqToLinear(ictcp.r) * 10000.0;
    float reference = layer.toneMappingParameters.y;
    float relative = max(luminance / reference, 0.0);
    float inputRange = maximumInput / reference;
    float outputRange = maximumOutput / reference;
    float v = (outputRange * (1.0 + inputRange) - inputRange) / (inputRange * inputRange);
    relative = relative * (1.0 + relative * v) / (1.0 + relative);
    ictcp.r = singleLinearToPq(relative * reference / 10000.0);

    vec3 linearLms = pqToLinear(fromICtCp * ictcp);
    vec4 transformedLms = vec4(linearLms, 1.0);
    color = vec3(dot(layer.lmsToDestinationX, transformedLms),
                 dot(layer.lmsToDestinationY, transformedLms),
                 dot(layer.lmsToDestinationZ, transformedLms)) * 10000.0;
    return clamp(color, vec3(0.0), vec3(maximumOutput));
}

vec3 srgbToLinear(vec3 color)
{
    bvec3 low = lessThanEqual(color, vec3(0.04045));
    return mix(pow((color + 0.055) / 1.055, vec3(12.0 / 5.0)), color / 12.92, low);
}

vec3 linearToSrgb(vec3 color)
{
    bvec3 low = lessThanEqual(color, vec3(0.0031308));
    return mix(pow(max(color, vec3(0.0)), vec3(5.0 / 12.0)) * 1.055 - 0.055, color * 12.92, low);
}

vec4 encodingToNits(vec4 color, uint transferFunction, float offset, float scale)
{
    if (transferFunction == 1u) {
        color.rgb = color.rgb * scale + vec3(offset);
        return color;
    }
    color.rgb /= max(color.a, 0.001);
    if (transferFunction == 0u) {
        color.rgb = srgbToLinear(color.rgb) * scale + vec3(offset);
    } else if (transferFunction == 2u) {
        color.rgb = pqToLinear(color.rgb) * scale + vec3(offset);
    } else if (transferFunction == 3u) {
        color.rgb = pow(max(color.rgb, vec3(0.0)), vec3(2.2)) * scale + vec3(offset);
    } else {
        color.rgb = scale * pow(max(color.rgb + vec3(offset), vec3(0.0)), vec3(2.4));
    }
    color.rgb *= color.a;
    return color;
}

vec4 nitsToEncoding(vec4 color, uint transferFunction, float offset, float scale)
{
    if (transferFunction == 1u) {
        color.rgb = (color.rgb - vec3(offset)) / scale;
        return color;
    }
    color.rgb /= max(color.a, 0.001);
    if (transferFunction == 0u) {
        color.rgb = linearToSrgb((color.rgb - vec3(offset)) / scale);
    } else if (transferFunction == 2u) {
        color.rgb = linearToPq((color.rgb - vec3(offset)) / scale);
    } else if (transferFunction == 3u) {
        color.rgb = pow(max((color.rgb - vec3(offset)) / scale, vec3(0.0)), vec3(1.0 / 2.2));
    } else {
        color.rgb = pow(max(color.rgb / scale, vec3(0.0)), vec3(1.0 / 2.4)) - vec3(offset);
    }
    color.rgb *= color.a;
    return color;
}

vec4 transformColor(Layer layer, vec4 source)
{
    uint sourceTransfer = layer.metadata.w & 0xffu;
    uint destinationTransfer = (layer.metadata.w >> 8) & 0xffu;
    source = encodingToNits(source, sourceTransfer, layer.transferParameters.x, layer.transferParameters.y);
    vec4 nits = vec4(source.rgb, 1.0);
    source.rgb = vec3(dot(layer.colorTransformX, nits),
                      dot(layer.colorTransformY, nits),
                      dot(layer.colorTransformZ, nits));
    float luminance = dot(source.rgb, layer.colorParameters.xyz);
    source.rgb = mix(vec3(luminance), source.rgb, layer.effects.y);
    if (layer.metadata.x > 0u) {
        source.rgb *= layer.color.rgb * layer.color.a;
        source.a *= layer.color.a;
    }
    source.rgb *= layer.effects.x;
    source.rgb = doToneMapping(layer, source.rgb);
    return nitsToEncoding(source, destinationTransfer, layer.transferParameters.z, layer.transferParameters.w);
}

vec4 processedTextureSampleAt(Layer layer, uint textureIndex, vec2 coordinates)
{
    vec4 source = sampleTexture(textureIndex, coordinates);
    if ((layer.metadata.z & (1u << 4)) != 0u) {
        return transformColor(layer, source);
    }
    if (layer.metadata.x > 0u) {
        source.rgb *= layer.color.rgb * layer.color.a;
        source.a *= layer.color.a;
    }
    float luminance = dot(source.rgb, vec3(0.2126, 0.7152, 0.0722));
    source.rgb = mix(vec3(luminance), source.rgb, layer.effects.y) * layer.effects.x;
    return source;
}

vec4 processedTextureSample(Layer layer, vec2 coordinates)
{
    return processedTextureSampleAt(layer, layer.textureIndices.x, coordinates);
}

vec3 zoomNitsSample(Layer layer, vec2 coordinates)
{
    vec4 source = processedTextureSample(layer, coordinates);
    uint destinationTransfer = (layer.metadata.w >> 8) & 0xffu;
    return encodingToNits(source, destinationTransfer, layer.transferParameters.z, layer.transferParameters.w).rgb;
}

float zoomColorDistance(Layer layer, vec3 a, vec3 b)
{
    return length((a - b) / max(layer.toneMappingParameters.y, 0.001));
}

bool zoomColorsSimilar(Layer layer, vec3 a, vec3 b)
{
    return zoomColorDistance(layer, a, b) < 0.2254;
}

float zoomScaledFillRatio(vec2 pixelOffset, vec2 splitOrigin, vec2 splitDirection, vec2 scale)
{
    vec2 offsetFromSplit = pixelOffset - splitOrigin;
    float distanceAlongSplit = dot(offsetFromSplit, splitDirection) / dot(splitDirection, splitDirection);
    vec2 positionOnSplit = splitDirection * distanceAlongSplit;
    vec2 distanceFromSplit = offsetFromSplit - positionOnSplit;
    vec2 perpendicularDirection = vec2(-splitDirection.y, splitDirection.x);
    float splitSide = sign(dot(offsetFromSplit, perpendicularDirection));
    float scaledDistance = splitSide * length(distanceFromSplit * scale);
    return smoothstep(-sqrt(2.0) / 2.0, sqrt(2.0) / 2.0, scaledDistance);
}

vec4 zoomPatternUpscale(Layer layer, vec2 coordinates)
{
    const int blendNone = 0;
    const int blendNormal = 1;
    const int blendDominant = 2;
    const float steepnessThreshold = 2.2;
    const float dominantDirectionThreshold = 3.6;

    vec2 textureDimensions = vec2(textureSize(textures[layer.textureIndices.x], 0));
    vec2 pixelSize = vec2(1.0) / textureDimensions;
    vec2 scale = vec2(layer.colorFilterParameters.x);
    vec2 pixelOffset = fract(coordinates * textureDimensions) - vec2(0.5);
    vec2 pixelCoord = coordinates - pixelOffset * pixelSize;

    // The 3x3 neighborhood is named by row and column. The outer ring is
    // sampled lazily only for corners that need pattern classification.
    vec3 B1 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(-1, -1));
    vec3 B2 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(0, -1));
    vec3 B3 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(1, -1));
    vec3 C1 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(-1, 0));
    vec3 C2 = zoomNitsSample(layer, pixelCoord);
    vec3 C3 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(1, 0));
    vec3 D1 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(-1, 1));
    vec3 D2 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(0, 1));
    vec3 D3 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(1, 1));

    ivec4 blendTypes = ivec4(blendNone);

    if (!((B1 == B2 && C1 == C2) || (B1 == C1 && B2 == C2)) && C2 != B2 && C2 != C1) {
        vec3 A1 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(-1, -2));
        vec3 A2 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(0, -2));
        vec3 B0 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(-2, -1));
        vec3 C0 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(-2, 0));
        float upwardGradient = 4.0 * zoomColorDistance(layer, B1, C2)
            + zoomColorDistance(layer, B2, C3) + zoomColorDistance(layer, C1, D2)
            + zoomColorDistance(layer, A1, B2) + zoomColorDistance(layer, B0, C1);
        float downwardGradient = 4.0 * zoomColorDistance(layer, C1, B2)
            + zoomColorDistance(layer, C2, B3) + zoomColorDistance(layer, D1, C2)
            + zoomColorDistance(layer, B1, A2) + zoomColorDistance(layer, C0, B1);
        if (downwardGradient < upwardGradient) {
            blendTypes.x = dominantDirectionThreshold * downwardGradient < upwardGradient ? blendDominant : blendNormal;
        }
    }

    if (!((B2 == B3 && C2 == C3) || (B2 == C2 && B3 == C3)) && C2 != B2 && C2 != C3) {
        vec3 A2 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(0, -2));
        vec3 A3 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(1, -2));
        vec3 B4 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(2, -1));
        vec3 C4 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(2, 0));
        float downwardGradient = 4.0 * zoomColorDistance(layer, B2, C3)
            + zoomColorDistance(layer, B3, C4) + zoomColorDistance(layer, C2, D3)
            + zoomColorDistance(layer, A2, B3) + zoomColorDistance(layer, B1, C2);
        float upwardGradient = 4.0 * zoomColorDistance(layer, C2, B3)
            + zoomColorDistance(layer, C3, B4) + zoomColorDistance(layer, D2, C3)
            + zoomColorDistance(layer, B2, A3) + zoomColorDistance(layer, C1, B2);
        if (upwardGradient > downwardGradient) {
            blendTypes.y = dominantDirectionThreshold * downwardGradient < upwardGradient ? blendDominant : blendNormal;
        }
    }

    if (!((C1 == C2 && D1 == D2) || (C1 == D1 && C2 == D2)) && C2 != C1 && C2 != D2) {
        vec3 E1 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(-1, 2));
        vec3 E2 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(0, 2));
        vec3 C0 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(-2, 0));
        vec3 D0 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(-2, 1));
        float downwardGradient = 4.0 * zoomColorDistance(layer, D2, C1)
            + zoomColorDistance(layer, C2, D3) + zoomColorDistance(layer, D1, E2)
            + zoomColorDistance(layer, B1, C2) + zoomColorDistance(layer, C0, D1);
        float upwardGradient = 4.0 * zoomColorDistance(layer, D1, C2)
            + zoomColorDistance(layer, D2, C3) + zoomColorDistance(layer, E1, D2)
            + zoomColorDistance(layer, C1, B2) + zoomColorDistance(layer, D0, C1);
        if (upwardGradient > downwardGradient) {
            blendTypes.z = dominantDirectionThreshold * downwardGradient < upwardGradient ? blendDominant : blendNormal;
        }
    }

    if (!((C2 == C3 && D2 == D3) || (C2 == D2 && C3 == D3)) && C2 != C3 && C2 != D2) {
        vec3 E2 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(0, 2));
        vec3 E3 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(1, 2));
        vec3 C4 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(2, 0));
        vec3 D4 = zoomNitsSample(layer, pixelCoord + pixelSize * vec2(2, 1));
        float downwardGradient = 4.0 * zoomColorDistance(layer, C2, D3)
            + zoomColorDistance(layer, C3, D4) + zoomColorDistance(layer, D2, E3)
            + zoomColorDistance(layer, B2, C3) + zoomColorDistance(layer, C1, D2);
        float upwardGradient = 4.0 * zoomColorDistance(layer, D2, C3)
            + zoomColorDistance(layer, D3, C4) + zoomColorDistance(layer, E2, D3)
            + zoomColorDistance(layer, C2, B3) + zoomColorDistance(layer, D1, C2);
        if (upwardGradient < downwardGradient) {
            blendTypes.w = dominantDirectionThreshold * upwardGradient < downwardGradient ? blendDominant : blendNormal;
        }
    }

    vec3 color = C2;

    if (blendTypes.x != blendNone) {
        float shallow = zoomColorDistance(layer, C1, B3);
        float steep = zoomColorDistance(layer, B2, D1);
        bool dominantCorner = blendTypes.x == blendDominant;
        bool bottomLeftBlend = blendTypes.z != blendNone && !zoomColorsSimilar(layer, C2, B3);
        bool topRightBlend = blendTypes.y != blendNone && !zoomColorsSimilar(layer, C2, D1);
        bool isCorner = !zoomColorsSimilar(layer, C2, B1)
            && zoomColorsSimilar(layer, D1, C1) && zoomColorsSimilar(layer, C1, B1)
            && zoomColorsSimilar(layer, B1, B2) && zoomColorsSimilar(layer, B2, B3);
        bool splitDiagonally = dominantCorner || (!bottomLeftBlend && !topRightBlend && !isCorner);
        vec2 origin = vec2(0, -1.0 / sqrt(2.0));
        vec2 direction = vec2(-1, 1);
        if (splitDiagonally) {
            float isShallow = steepnessThreshold * shallow <= steep && C2 != B3 && C3 != B3 ? 1.0 : 0.0;
            float isSteep = steepnessThreshold * steep <= shallow && C2 != D1 && D1 != D2 ? 1.0 : 0.0;
            origin = vec2(0, -0.5 * (1.0 - 0.5 * isShallow));
            direction.x -= isShallow;
            direction.y += isSteep;
        }
        vec3 fillColor = mix(C1, B2, step(zoomColorDistance(layer, C2, B2), zoomColorDistance(layer, C2, C1)));
        color = mix(color, fillColor, zoomScaledFillRatio(pixelOffset, origin, direction, scale));
    }

    if (blendTypes.y != blendNone) {
        float shallow = zoomColorDistance(layer, C3, B1);
        float steep = zoomColorDistance(layer, B2, D3);
        bool dominantCorner = blendTypes.y == blendDominant;
        bool bottomRightBlend = blendTypes.w != blendNone && !zoomColorsSimilar(layer, C2, B1);
        bool topLeftBlend = blendTypes.x != blendNone && !zoomColorsSimilar(layer, C2, D3);
        bool isCorner = !zoomColorsSimilar(layer, C2, B3)
            && zoomColorsSimilar(layer, D3, C3) && zoomColorsSimilar(layer, C3, B3)
            && zoomColorsSimilar(layer, B3, B2) && zoomColorsSimilar(layer, B2, B1);
        bool splitDiagonally = dominantCorner || (!bottomRightBlend && !topLeftBlend && !isCorner);
        vec2 origin = vec2(1.0 / sqrt(2.0), 0);
        vec2 direction = vec2(-1, -1);
        if (splitDiagonally) {
            float isShallow = steepnessThreshold * steep <= shallow && C2 != D3 && D2 != D3 ? 1.0 : 0.0;
            float isSteep = steepnessThreshold * shallow <= steep && C2 != B1 && C1 != B1 ? 1.0 : 0.0;
            origin = vec2(0.5 * (1.0 - 0.5 * isShallow), 0);
            direction.x -= isSteep;
            direction.y -= isShallow;
        }
        vec3 fillColor = mix(C3, B2, step(zoomColorDistance(layer, C2, B2), zoomColorDistance(layer, C2, C3)));
        color = mix(color, fillColor, zoomScaledFillRatio(pixelOffset, origin, direction, scale));
    }

    if (blendTypes.z != blendNone) {
        float shallow = zoomColorDistance(layer, C1, D3);
        float steep = zoomColorDistance(layer, D2, B1);
        bool dominantCorner = blendTypes.z == blendDominant;
        bool topLeftBlend = blendTypes.x != blendNone && !zoomColorsSimilar(layer, C2, D3);
        bool bottomRightBlend = blendTypes.w != blendNone && !zoomColorsSimilar(layer, C2, B1);
        bool isCorner = !zoomColorsSimilar(layer, C2, D1)
            && zoomColorsSimilar(layer, D3, D2) && zoomColorsSimilar(layer, D2, D1)
            && zoomColorsSimilar(layer, D1, C1) && zoomColorsSimilar(layer, C1, B1);
        bool splitDiagonally = dominantCorner || (!topLeftBlend && !bottomRightBlend && !isCorner);
        vec2 origin = vec2(-1.0 / sqrt(2.0), 0);
        vec2 direction = vec2(1, 1);
        if (splitDiagonally) {
            float isShallow = steepnessThreshold * steep <= shallow && C2 != B1 && B2 != B1 ? 1.0 : 0.0;
            float isSteep = steepnessThreshold * shallow <= steep && C2 != D3 && C3 != D3 ? 1.0 : 0.0;
            origin = vec2(-0.5 * (1.0 - 0.5 * isShallow), 0);
            direction.x += isSteep;
            direction.y += isShallow;
        }
        vec3 fillColor = mix(D2, C1, step(zoomColorDistance(layer, C2, C1), zoomColorDistance(layer, C2, D2)));
        color = mix(color, fillColor, zoomScaledFillRatio(pixelOffset, origin, direction, scale));
    }

    if (blendTypes.w != blendNone) {
        float shallow = zoomColorDistance(layer, C3, D1);
        float steep = zoomColorDistance(layer, D2, B3);
        bool dominantCorner = blendTypes.w == blendDominant;
        bool topRightBlend = blendTypes.y != blendNone && !zoomColorsSimilar(layer, C2, D1);
        bool bottomLeftBlend = blendTypes.z != blendNone && !zoomColorsSimilar(layer, C2, B3);
        bool isCorner = !zoomColorsSimilar(layer, C2, D3)
            && zoomColorsSimilar(layer, B3, C3) && zoomColorsSimilar(layer, C3, D3)
            && zoomColorsSimilar(layer, D3, D2) && zoomColorsSimilar(layer, D2, D1);
        bool splitDiagonally = dominantCorner || (!topRightBlend && !bottomLeftBlend && !isCorner);
        vec2 origin = vec2(0, 1.0 / sqrt(2.0));
        vec2 direction = vec2(1, -1);
        if (splitDiagonally) {
            float isShallow = steepnessThreshold * shallow <= steep && C2 != D1 && C1 != D1 ? 1.0 : 0.0;
            float isSteep = steepnessThreshold * steep <= shallow && C2 != B3 && B3 != B2 ? 1.0 : 0.0;
            origin = vec2(0, 0.5 * (1.0 - 0.5 * isShallow));
            direction.x += isShallow;
            direction.y -= isSteep;
        }
        vec3 fillColor = mix(D2, C3, step(zoomColorDistance(layer, C2, C3), zoomColorDistance(layer, C2, D2)));
        color = mix(color, fillColor, zoomScaledFillRatio(pixelOffset, origin, direction, scale));
    }

    uint destinationTransfer = (layer.metadata.w >> 8) & 0xffu;
    return nitsToEncoding(vec4(color, 1.0), destinationTransfer, layer.transferParameters.z, layer.transferParameters.w);
}

vec4 dualKawaseUpsample(Layer layer, vec2 coordinates)
{
    vec2 halfpixel = vec2(0.5) / vec2(textureSize(textures[layer.textureIndices.x], 0));
    float offset = layer.colorFilterParameters.x;
    vec4 sum = sampleTexture(layer.textureIndices.x, coordinates + vec2(-halfpixel.x * 2.0, 0.0) * offset);
    sum += sampleTexture(layer.textureIndices.x, coordinates + vec2(-halfpixel.x, halfpixel.y) * offset) * 2.0;
    sum += sampleTexture(layer.textureIndices.x, coordinates + vec2(0.0, halfpixel.y * 2.0) * offset);
    sum += sampleTexture(layer.textureIndices.x, coordinates + vec2(halfpixel.x, halfpixel.y) * offset) * 2.0;
    sum += sampleTexture(layer.textureIndices.x, coordinates + vec2(halfpixel.x * 2.0, 0.0) * offset);
    sum += sampleTexture(layer.textureIndices.x, coordinates + vec2(halfpixel.x, -halfpixel.y) * offset) * 2.0;
    sum += sampleTexture(layer.textureIndices.x, coordinates + vec2(0.0, -halfpixel.y * 2.0) * offset);
    sum += sampleTexture(layer.textureIndices.x, coordinates + vec2(-halfpixel.x, -halfpixel.y) * offset) * 2.0;
    return sum / 12.0;
}

vec4 applyColorFilter(Layer layer, vec4 source, vec2 coordinates, vec2 samplePosition, float vertexFractional)
{
    uint filterType = layer.metadata.y;
    if (filterType == 0u) {
        return source;
    }
    uint destinationTransfer = (layer.metadata.w >> 8) & 0xffu;
    float referenceLuminance = layer.toneMappingParameters.y;
    if (filterType == 1u) {
        source = encodingToNits(source, destinationTransfer, layer.transferParameters.z, layer.transferParameters.w);
        source = nitsToEncoding(source, 3u, 0.0, referenceLuminance);
        source.rgb /= max(source.a, 0.001);
        source.rgb = vec3(1.0) - source.rgb;
        source.rgb *= source.a;
        source = encodingToNits(source, 3u, 0.0, referenceLuminance);
        return nitsToEncoding(source, destinationTransfer, layer.transferParameters.z, layer.transferParameters.w);
    } else if (filterType == 2u) {
        return vec4(layer.colorFilterParameters.rgb * layer.colorFilterParameters.a,
                    layer.colorFilterParameters.a);
    } else if (filterType == 3u) {
        source = encodingToNits(source, destinationTransfer, layer.transferParameters.z, layer.transferParameters.w);
        vec4 value = vec4(source.rgb, 1.0);
        source.rgb = vec3(dot(layer.colorFilterMatrixX, value),
                          dot(layer.colorFilterMatrixY, value),
                          dot(layer.colorFilterMatrixZ, value));
        return nitsToEncoding(source, destinationTransfer, layer.transferParameters.z, layer.transferParameters.w);
    } else if (filterType == 4u) {
        vec2 halfpixel = vec2(0.5) / vec2(textureSize(textures[layer.textureIndices.x], 0));
        float offset = layer.colorFilterParameters.x;
        vec4 sum = source * 4.0;
        sum += sampleTexture(layer.textureIndices.x, coordinates - halfpixel * offset);
        sum += sampleTexture(layer.textureIndices.x, coordinates + halfpixel * offset);
        sum += sampleTexture(layer.textureIndices.x, coordinates + vec2(halfpixel.x, -halfpixel.y) * offset);
        sum += sampleTexture(layer.textureIndices.x, coordinates - vec2(halfpixel.x, -halfpixel.y) * offset);
        return sum / 8.0;
    } else if (filterType == 5u || filterType == 6u) {
        source = dualKawaseUpsample(layer, coordinates);
        if (filterType == 6u) {
            vec4 value = vec4(source.rgb, 1.0);
            source.rgb = vec3(dot(layer.colorFilterMatrixX, value),
                              dot(layer.colorFilterMatrixY, value),
                              dot(layer.colorFilterMatrixZ, value));
        }
        return source;
    } else if (filterType == 7u) {
        ivec2 size = textureSize(textures[layer.textureIndices.x], 0);
        ivec2 pixel = ivec2(mod(floor(samplePosition), vec2(size)));
        float noise = texelFetch(textures[layer.textureIndices.x], pixel, 0).r * layer.colorFilterParameters.y;
        return vec4(noise, noise, noise, 0.0);
    } else if (filterType == 8u) {
        const float strength = 0.4;
        const float fractionalPrecision = 0.01;
        const float errorCorrection = 1.0 / fractionalPrecision;
        vec2 geometrySize = vec2(textureSize(textures[layer.textureIndices.x], 0));
        vec2 sourcePixel = coordinates * geometrySize + vec2(0.5);
        sourcePixel = round(sourcePixel * errorCorrection) / errorCorrection;
        float error = dot(fract(sourcePixel), vec2(1.0));
        source = vec4(0.0);
        if (vertexFractional > 0.5) {
            source = mix(source, vec4(0.0, 0.0, 1.0, 1.0), strength);
        }
        if (error > fractionalPrecision) {
            source = mix(source, vec4(1.0, 0.0, 0.0, 1.0), strength);
        }
        return source;
    } else if (filterType == 9u) {
        vec2 textureDimensions = vec2(textureSize(textures[layer.textureIndices.x], 0));
        vec2 sampleInPixels = coordinates * textureDimensions;
        vec2 pixelCenter = floor(sampleInPixels) + vec2(0.5);
        vec2 centerDistance = abs(sampleInPixels - pixelCenter);
        float grid = smoothstep(0.4, 0.5, max(centerDistance.x, centerDistance.y));
        return mix(processedTextureSample(layer, pixelCenter / textureDimensions), vec4(0, 0, 0, 1), grid);
    } else if (filterType == 10u) {
        return zoomPatternUpscale(layer, coordinates);
    } else if (filterType == 11u) {
        vec4 previous = processedTextureSampleAt(layer, layer.textureIndices.y, coordinates);
        return mix(previous, source, clamp(layer.colorFilterParameters.x, 0.0, 1.0));
    }
    return source;
}

bool triangleCoordinates(vec2 point, vec2 a, vec2 b, vec2 c, out vec3 weights)
{
    vec2 edge0 = b - a;
    vec2 edge1 = c - a;
    vec2 relative = point - a;
    float denominator = edge0.x * edge1.y - edge1.x * edge0.y;
    if (abs(denominator) < 0.000001) {
        return false;
    }
    weights.y = (relative.x * edge1.y - edge1.x * relative.y) / denominator;
    weights.z = (edge0.x * relative.y - relative.x * edge0.y) / denominator;
    weights.x = 1.0 - weights.y - weights.z;
    return all(greaterThanEqual(weights, vec3(-0.00001)));
}

bool quadCoordinates(Layer layer, vec2 point, out vec2 coordinates)
{
    vec2 positions[4] = vec2[4](
        vec2(layer.quadPositionX.x, layer.quadPositionY.x),
        vec2(layer.quadPositionX.y, layer.quadPositionY.y),
        vec2(layer.quadPositionX.z, layer.quadPositionY.z),
        vec2(layer.quadPositionX.w, layer.quadPositionY.w));
    vec2 textureCoordinates[4] = vec2[4](
        vec2(layer.quadTextureX.x, layer.quadTextureY.x),
        vec2(layer.quadTextureX.y, layer.quadTextureY.y),
        vec2(layer.quadTextureX.z, layer.quadTextureY.z),
        vec2(layer.quadTextureX.w, layer.quadTextureY.w));
    vec3 weights;
    if (triangleCoordinates(point, positions[0], positions[1], positions[2], weights)) {
        coordinates = textureCoordinates[0] * weights.x
            + textureCoordinates[1] * weights.y
            + textureCoordinates[2] * weights.z;
        return true;
    }
    if (triangleCoordinates(point, positions[0], positions[2], positions[3], weights)) {
        coordinates = textureCoordinates[0] * weights.x
            + textureCoordinates[2] * weights.y
            + textureCoordinates[3] * weights.z;
        return true;
    }
    return false;
}

float interpolatedVertexFractional(Layer layer, vec2 localPosition)
{
    vec2 positions[4];
    if ((layer.metadata.z & (1u << 5)) != 0u) {
        positions = vec2[4](
            vec2(layer.quadPositionX.x, layer.quadPositionY.x),
            vec2(layer.quadPositionX.y, layer.quadPositionY.y),
            vec2(layer.quadPositionX.z, layer.quadPositionY.z),
            vec2(layer.quadPositionX.w, layer.quadPositionY.w));
    } else {
        positions = vec2[4](
            layer.localRect.xy,
            vec2(layer.localRect.z, layer.localRect.y),
            layer.localRect.zw,
            vec2(layer.localRect.x, layer.localRect.w));
    }
    vec3 weights;
    if (triangleCoordinates(localPosition, positions[0], positions[1], positions[2], weights)) {
        return dot(vec3(layer.colorFilterMatrixX.x, layer.colorFilterMatrixX.y, layer.colorFilterMatrixX.z), weights);
    }
    if (triangleCoordinates(localPosition, positions[0], positions[2], positions[3], weights)) {
        return dot(vec3(layer.colorFilterMatrixX.x, layer.colorFilterMatrixX.z, layer.colorFilterMatrixX.w), weights);
    }
    return 0.0;
}

vec3 outputLutValue(uvec3 coordinate)
{
    uint edge = uint(params.outputLutParameters.z);
    uint index = coordinate.z * edge * edge + coordinate.y * edge + coordinate.x;
    return outputLut[index].rgb;
}

vec3 applyOutputLut(vec3 color)
{
    float minimum = params.outputLutParameters.x;
    float maximum = params.outputLutParameters.y;
    float edge = params.outputLutParameters.z;
    vec3 position = clamp((color - vec3(minimum)) / max(maximum - minimum, 0.000001), vec3(0.0), vec3(1.0)) * (edge - 1.0);
    uvec3 lower = uvec3(floor(position));
    uvec3 upper = min(lower + uvec3(1), uvec3(uint(edge) - 1u));
    vec3 fraction = fract(position);
    vec3 z0 = mix(mix(outputLutValue(uvec3(lower.x, lower.y, lower.z)),
                      outputLutValue(uvec3(upper.x, lower.y, lower.z)), fraction.x),
                  mix(outputLutValue(uvec3(lower.x, upper.y, lower.z)),
                      outputLutValue(uvec3(upper.x, upper.y, lower.z)), fraction.x), fraction.y);
    vec3 z1 = mix(mix(outputLutValue(uvec3(lower.x, lower.y, upper.z)),
                      outputLutValue(uvec3(upper.x, lower.y, upper.z)), fraction.x),
                  mix(outputLutValue(uvec3(lower.x, upper.y, upper.z)),
                      outputLutValue(uvec3(upper.x, upper.y, upper.z)), fraction.x), fraction.y);
    return mix(z0, z1, fraction.z);
}

bool evaluateLayer(Layer layer, vec2 samplePosition, out vec4 source, out float coverage)
{
    if ((layer.metadata.z & 1u) != 0u
            && (samplePosition.x < layer.clipRect.x || samplePosition.x >= layer.clipRect.z
                || samplePosition.y < layer.clipRect.y || samplePosition.y >= layer.clipRect.w)) {
        return false;
    }
    vec3 outputPosition = vec3(samplePosition, 1.0);
    vec2 localPosition = vec2(dot(layer.inverseTransformX.xyz, outputPosition),
                              dot(layer.inverseTransformY.xyz, outputPosition));
    vec4 localRect = layer.localRect;
    vec2 position;
    if ((layer.metadata.z & (1u << 5)) != 0u) {
        if (!quadCoordinates(layer, localPosition, position)) {
            return false;
        }
    } else {
        if (localPosition.x < localRect.x || localPosition.x >= localRect.z
                || localPosition.y < localRect.y || localPosition.y >= localRect.w) {
            return false;
        }
        position = (localPosition - localRect.xy) / (localRect.zw - localRect.xy);
    }

    coverage = shapeCoverage(layer, localPosition);
    if (coverage <= 0.0) {
        return false;
    }
    vec2 coordinates = vec2(0.0);
    if (layer.metadata.x > 0u) {
        vec3 texturePosition = vec3(position, 1.0);
        position = vec2(dot(layer.textureTransformX.xyz, texturePosition),
                        dot(layer.textureTransformY.xyz, texturePosition));
        coordinates = mix(layer.sourceRect.xy, layer.sourceRect.zw, position);
        if (layer.metadata.x == 1u) {
            source = sampleTexture(layer.textureIndices.x, coordinates);
        } else if (layer.metadata.x == 2u) {
            source = vec4(sampleTexture(layer.textureIndices.x, coordinates).r,
                          sampleTexture(layer.textureIndices.y, coordinates).rg,
                          1.0);
        } else {
            source = vec4(sampleTexture(layer.textureIndices.x, coordinates).r,
                          sampleTexture(layer.textureIndices.y, coordinates).r,
                          sampleTexture(layer.textureIndices.z, coordinates).r,
                          1.0);
        }
        if (layer.metadata.x > 1u) {
            vec4 yuv = source;
            source.rgb = vec3(dot(layer.yuvTransformX, yuv),
                              dot(layer.yuvTransformY, yuv),
                              dot(layer.yuvTransformZ, yuv));
        }
    } else {
        source = layer.color;
    }
    if ((layer.metadata.z & (1u << 4)) != 0u) {
        source = transformColor(layer, source);
    } else {
        if (layer.metadata.x > 0u) {
            source.rgb *= layer.color.rgb * layer.color.a;
            source.a *= layer.color.a;
        }
        float luminance = dot(source.rgb, vec3(0.2126, 0.7152, 0.0722));
        source.rgb = mix(vec3(luminance), source.rgb, layer.effects.y) * layer.effects.x;
    }
    float vertexFractional = layer.metadata.y == 8u
        ? interpolatedVertexFractional(layer, localPosition)
        : 0.0;
    source = applyColorFilter(layer, source, coordinates, samplePosition, vertexFractional);
    source *= coverage;
    return true;
}

void main()
{
    uint dirtyTileIndex = gl_WorkGroupID.x;
    if (dirtyTileIndex >= params.dirtyTileCount) {
        return;
    }
    uint tileIndex = dirtyTiles[dirtyTileIndex];
    uint tileX = tileIndex % params.tilesWide;
    uint tileY = tileIndex / params.tilesWide;
    ivec2 pixel = ivec2(tileX, tileY) * 16 + ivec2(gl_LocalInvocationID.xy);
    ivec2 outputSize = imageSize(destination);
    if (any(greaterThanEqual(pixel, outputSize))) {
        return;
    }

    uint listBase = tileIndex * (params.layerCount + 1u);
    uint tileLayerCount = tileData[listBase];
    vec2 samplePosition = vec2(pixel) + vec2(0.5);
    vec4 background = (params.flags & (1u << 1)) != 0u
        ? imageLoad(destination, pixel)
        : params.background;
    vec4 result;
    if ((params.flags & 1u) == 0u) {
        // Source-over is associative. Walking front-to-back lets opaque
        // content terminate immediately without touching occluded layers.
        result = vec4(0.0);
        float remaining = 1.0;
        for (int i = int(tileLayerCount) - 1; i >= 0 && remaining > 0.0; --i) {
            uint layerIndex = tileData[listBase + 1u + uint(i)];
            if (layerIndex < params.firstLayer || layerIndex >= params.lastLayer) {
                continue;
            }
            vec4 source;
            float coverage;
            if (!evaluateLayer(layers[layerIndex], samplePosition, source, coverage)) {
                continue;
            }
            result += source * remaining;
            remaining *= 1.0 - source.a;
        }
        result += background * remaining;
    } else {
        // Destination-out depends on the accumulated destination below it,
        // so preserve strict bottom-to-top Porter-Duff order for those scenes.
        result = background;
        for (uint i = 0; i < tileLayerCount; ++i) {
            uint layerIndex = tileData[listBase + 1u + i];
            if (layerIndex < params.firstLayer || layerIndex >= params.lastLayer) {
                continue;
            }
            Layer layer = layers[layerIndex];
            vec4 source;
            float coverage;
            if (!evaluateLayer(layer, samplePosition, source, coverage)) {
                continue;
            }
            if ((layer.metadata.z & (1u << 3)) != 0u) {
                result = (source + result) * (1.0 - source.a);
            } else if ((layer.metadata.z & (1u << 6)) != 0u) {
                float amount = clamp(layer.colorFilterParameters.y * coverage, 0.0, 1.0);
                result = mix(result, source / max(coverage, 0.0001), amount);
            } else if ((layer.metadata.z & (1u << 7)) != 0u) {
                result += source;
            } else {
                result = source + result * (1.0 - source.a);
            }
        }
    }
    if ((params.flags & (1u << 2)) != 0u) {
        float alpha = result.a;
        result.rgb = applyOutputLut(result.rgb / max(alpha, 0.001)) * alpha;
    }
    imageStore(destination, pixel, result);
}
