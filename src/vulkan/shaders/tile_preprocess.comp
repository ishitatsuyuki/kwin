#version 450

// The binning monoid is a pair of 32-layer masks under XOR. A rectangle
// toggles its layer bit at four corners of a 2D difference grid; an inclusive
// 2D XOR scan reconstructs exact tile membership. The second mask tracks tiles
// that are fully covered by guaranteed-opaque layers.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct HotLayer
{
    vec4 rect;
    vec4 color;
    vec4 textureCoordinatesX;
    vec4 textureCoordinatesY;
    vec4 effects;
    uvec4 textureIndices;
    uvec4 metadata;
};

layout(std430, set = 0, binding = 6) readonly buffer HotLayerBuffer
{
    HotLayer layers[];
};

// Two uints (present, opaque) for every tile and mask word.
layout(std430, set = 0, binding = 7) writeonly buffer PrefixBuffer
{
    uint prefixData[];
};

layout(push_constant) uniform Parameters
{
    uint layerCount;
    uint tilesWide;
    uint flags;
    uint dirtyTileCount;
    vec4 background;
    uint firstLayer;
    uint lastLayer;
    uvec2 outputSize;
    vec4 outputLutParameters;
} params;

shared uint localPresent[256];
shared uint localOpaque[256];

void toggleCorner(ivec2 corner, ivec2 binOrigin, uint bit, bool opaque)
{
    ivec2 local = corner - binOrigin;
    if (all(greaterThanEqual(local, ivec2(0))) && all(lessThan(local, ivec2(16)))) {
        uint index = uint(local.y * 16 + local.x);
        if (opaque) {
            atomicXor(localOpaque[index], bit);
        } else {
            atomicXor(localPresent[index], bit);
        }
    }
}

void toggleRectangle(ivec4 tiles, ivec2 binOrigin, uint bit, bool opaque)
{
    if (tiles.x >= tiles.z || tiles.y >= tiles.w) {
        return;
    }
    toggleCorner(tiles.xy, binOrigin, bit, opaque);
    toggleCorner(ivec2(tiles.z, tiles.y), binOrigin, bit, opaque);
    toggleCorner(ivec2(tiles.x, tiles.w), binOrigin, bit, opaque);
    toggleCorner(tiles.zw, binOrigin, bit, opaque);
}

void main()
{
    uint localIndex = gl_LocalInvocationIndex;
    localPresent[localIndex] = 0u;
    localOpaque[localIndex] = 0u;
    barrier();

    uint maskWord = gl_WorkGroupID.z;
    uint layerIndex = maskWord * 32u + localIndex;
    ivec2 tilesSize = ivec2(int(params.tilesWide), int((params.outputSize.y + 15u) / 16u));
    ivec2 binOrigin = ivec2(gl_WorkGroupID.xy) * 16;
    if (localIndex < 32u && layerIndex < params.layerCount) {
        HotLayer layer = layers[layerIndex];
        ivec4 presentTiles = ivec4(floor(layer.rect.xy / 16.0), ceil(layer.rect.zw / 16.0));
        presentTiles.xy = clamp(presentTiles.xy, ivec2(0), tilesSize);
        presentTiles.zw = clamp(presentTiles.zw, ivec2(0), tilesSize);
        uint bit = 1u << (layerIndex & 31u);
        toggleRectangle(presentTiles, binOrigin, bit, false);

        if ((layer.metadata.z & (1u << 13)) != 0u) {
            ivec4 opaqueTiles = ivec4(ceil(layer.rect.xy / 16.0), floor(layer.rect.zw / 16.0));
            // The final output tile may be smaller than 16x16.
            if ((params.outputSize.x & 15u) != 0u && layer.rect.z >= float(params.outputSize.x)) {
                opaqueTiles.z = tilesSize.x;
            }
            if ((params.outputSize.y & 15u) != 0u && layer.rect.w >= float(params.outputSize.y)) {
                opaqueTiles.w = tilesSize.y;
            }
            opaqueTiles.xy = clamp(opaqueTiles.xy, ivec2(0), tilesSize);
            opaqueTiles.zw = clamp(opaqueTiles.zw, ivec2(0), tilesSize);
            toggleRectangle(opaqueTiles, binOrigin, bit, true);
        }
    }
    barrier();

    uint x = gl_LocalInvocationID.x;
    uint y = gl_LocalInvocationID.y;
    for (uint offset = 1u; offset < 16u; offset <<= 1u) {
        uint present = x >= offset ? localPresent[localIndex - offset] : 0u;
        uint opaque = x >= offset ? localOpaque[localIndex - offset] : 0u;
        barrier();
        localPresent[localIndex] ^= present;
        localOpaque[localIndex] ^= opaque;
        barrier();
    }
    for (uint offset = 1u; offset < 16u; offset <<= 1u) {
        uint present = y >= offset ? localPresent[localIndex - offset * 16u] : 0u;
        uint opaque = y >= offset ? localOpaque[localIndex - offset * 16u] : 0u;
        barrier();
        localPresent[localIndex] ^= present;
        localOpaque[localIndex] ^= opaque;
        barrier();
    }

    ivec2 tile = binOrigin + ivec2(gl_LocalInvocationID.xy);
    if (all(lessThan(tile, tilesSize))) {
        uint maskWordCount = (params.layerCount + 31u) / 32u;
        uint tileIndex = uint(tile.y) * params.tilesWide + uint(tile.x);
        uint base = (tileIndex * maskWordCount + maskWord) * 2u;
        prefixData[base] = localPresent[localIndex];
        prefixData[base + 1u] = localOpaque[localIndex];
    }
}
