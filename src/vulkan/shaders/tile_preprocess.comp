#version 450

// One invocation owns one Pathfinder-style 16x16 tile. The initial
// implementation deliberately tests every layer AABB and stores a per-tile
// list of intersecting layer indices. Later implementations can replace this
// pass with hierarchical binning without changing the composition pass.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct HotLayer
{
    vec4 rect;
    vec4 color;
    vec4 textureCoordinatesX;
    vec4 textureCoordinatesY;
    vec4 effects;
    uvec4 textureIndices;
    uvec4 metadata;
};

layout(std430, set = 0, binding = 6) readonly buffer HotLayerBuffer
{
    HotLayer layers[];
};

layout(std430, set = 0, binding = 1) writeonly buffer TileBuffer
{
    uint tileData[];
};

layout(std430, set = 0, binding = 4) readonly buffer DirtyTileBuffer
{
    uint dirtyTiles[];
};

layout(push_constant) uniform Parameters
{
    uint layerCount;
    uint tilesWide;
    uint flags;
    uint dirtyTileCount;
    vec4 background;
    uint firstLayer;
    uint lastLayer;
    uvec2 outputSize;
    vec4 outputLutParameters;
} params;

void main()
{
    uint dirtyTileIndex = gl_GlobalInvocationID.x;
    if (dirtyTileIndex >= params.dirtyTileCount) {
        return;
    }
    uint packedTile = dirtyTiles[dirtyTileIndex];
    uint tileX = packedTile & 0xffffu;
    uint tileY = packedTile >> 16;
    uint tileIndex = tileY * params.tilesWide + tileX;
    vec2 tileMin = vec2(tileX, tileY) * 16.0;
    vec2 tileMax = min(tileMin + vec2(16.0), vec2(params.outputSize));
    uint listBase = tileIndex * (params.layerCount + 1u);
    uint count = 0u;

    for (uint i = 0; i < params.layerCount; ++i) {
        vec4 rect = layers[i].rect;
        bool intersects = rect.x < tileMax.x && rect.z > tileMin.x
            && rect.y < tileMax.y && rect.w > tileMin.y;
        if (intersects) {
            bool fullyCovers = (layers[i].metadata.z & (1u << 13)) != 0u
                && rect.x <= tileMin.x && rect.z >= tileMax.x
                && rect.y <= tileMin.y && rect.w >= tileMax.y;
            if (fullyCovers) {
                count = 0u;
            }
            tileData[listBase + 1u + count] = i;
            ++count;
        }
    }
    tileData[listBase] = count;
}
